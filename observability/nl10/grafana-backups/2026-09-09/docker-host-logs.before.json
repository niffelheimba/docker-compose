{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Containers that emitted at least one log line in the last five minutes. This is activity, not a Docker running-state check.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(sum by (container) (count_over_time({source=\"docker\",host=~\"${host:regex}\",compose_project=~\"${project:regex}\",container=~\"${container:regex}\"}[5m])))",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Containers with logs (last 5m)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Matches error, err, fatal, panic, exception, failed, or failure, case-insensitively.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({source=\"docker\",container!~\"grafana|loki\",host=~\"${host:regex}\",compose_project=~\"${project:regex}\",container=~\"${container:regex}\"} |~ \"(?i)\\\\b(err(or)?|fatal|panic|exception|failed|failure)\\\\b\" |!~ \"(?i)(level=(info|debug)|without errors?|no errors?)\" [$__range]))",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Error-like logs in range",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Populates after Alloy journald collection is enabled.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "noValue": "Not collected",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({source=\"journal\",host=~\"${host:regex}\"}[$__range]))",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Host journal lines in range",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Only containers with error-like logs in the last five minutes appear. Yellow indicates an active log warning; red indicates 10 or more matching lines. This is log-derived status, not Docker health.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "View this container's logs",
              "url": "/d/docker-host-logs/docker-host-logs?var-host=${host}&var-project=All&var-container=${__field.labels.container}&from=${__from}&to=${__to}"
            }
          ],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 4,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "sum by (container, compose_project) (count_over_time({source=\"docker\",container!~\"grafana|loki\",host=~\"${host:regex}\",compose_project=~\"${project:regex}\",container=~\"${container:regex}\"} |~ \"(?i)\\\\b(err(or)?|exception|failed|failure)\\\\b\" |!~ \"(?i)(level=(info|debug)|without errors?|no errors?)\" [5m]))",
          "instant": true,
          "legendFormat": "{{compose_project}} / {{container}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Containers with ongoing error logs (last 5m)",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "sum",
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (container) (count_over_time({source=\"docker\",host=~\"${host:regex}\",compose_project=~\"${project:regex}\",container=~\"${container:regex}\"}[$__interval]))",
          "legendFormat": "{{container}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log volume by container",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{source=\"docker\",host=~\"${host:regex}\",compose_project=~\"${project:regex}\",container=~\"${container:regex}\"} |= \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Container logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{source=\"docker\",container!~\"grafana|loki\",host=~\"${host:regex}\",compose_project=~\"${project:regex}\",container=~\"${container:regex}\"} |~ \"(?i)\\\\b(err(or)?|fatal|panic|exception|failed|failure)\\\\b\" |!~ \"(?i)(level=(info|debug)|without errors?|no errors?)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors, failures, and crashes",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Separate host/systemd journal stream. This remains empty until the Alloy journal source and host journal mounts are deployed.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{source=\"journal\",host=~\"${host:regex}\"} |= \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Host journal",
      "type": "logs"
    }
  ],
  "refresh": "30s",
