          "uid": "loki"
        },
        "definition": "label_values({source=\"docker\", host=~\"${host:regex}\"}, compose_project)",
        "includeAll": true,
        "label": "Compose project",
        "multi": true,
        "name": "project",
        "options": [],
        "query": "label_values({source=\"docker\", host=~\"${host:regex}\"}, compose_project)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({source=\"docker\", host=~\"${host:regex}\", compose_project=~\"${project:regex}\"}, container)",
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "options": [],
        "query": "label_values({source=\"docker\", host=~\"${host:regex}\", compose_project=~\"${project:regex}\"}, container)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
