      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "browser",
  "title": "Docker & Host Logs",
  "uid": "docker-host-logs",
  "weekStart": "",
  "description": "Docker and host logs with actionable error classification. Loki/Grafana application logs are excluded from error views. Counts are log-derived, not container health."
}
