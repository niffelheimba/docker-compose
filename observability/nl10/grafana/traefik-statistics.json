    {
      "id": 13,
      "title": "Errors by middleware (selected range)",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Which middleware produces operational errors; blank middleware means the line did not identify one.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host,middleware) (count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} !~ `\"DownstreamStatus\"\\s*:` | decolorize | line_format `{{ __line__ }}` |~ `\\bERR\\b|level=error` | regexp `middlewareName=(?P<middleware>[^ ]+)` [$__range]))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{host}} / {{middleware}}"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Host",
              "middleware": "Middleware",
              "Value": "Errors",
              "Value #A": "Errors"
            }
          }
        }
      ]
    },
    {
      "id": 14,
      "title": "Operational logs — original messages",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Original Traefik messages with ANSI color codes removed. Text filter applies here and to access logs.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} !~ `\"DownstreamStatus\"\\s*:` | decolorize | line_format `{{ __line__ }}` |= \"$search\" | line_format \"{{.host}} | {{ __line__ }}\"",
          "queryType": "range",
          "instant": false,
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 15,
      "title": "HTTP access logs — status, route, request, duration",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Readable request summary. Expand log details to inspect parsed fields. Duration is in nanoseconds in this log view.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "",
          "color": {
            "mode": "palette-classic"
