        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Error lines excluding context-canceled messages.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Awaiting access logs",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
