        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} !~ `\"DownstreamStatus\"\\s*:` | decolorize | line_format `{{ __line__ }}` |~ `\\bERR\\b|level=error` != \"context canceled\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
