{
  "uid": "traefik-statistics",
  "title": "Traefik Statistics",
  "description": "Traefik operational log statistics and HTTP traffic/latency from JSON access logs. HTTP panels require access-log ingestion.",
  "schemaVersion": 42,
  "editable": true,
  "tags": [
    "traefik",
    "loki",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Docker & Host Logs",
      "type": "link",
      "url": "/d/docker-host-logs/docker-and-host-logs",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Traefik host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({source=\"docker\",container=\"traefik\"},host)",
        "definition": "label_values({source=\"docker\",container=\"traefik\"},host)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "options": []
      },
      {
        "name": "search",
        "label": "Log text filter",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Collection status and how to read this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "**Operational logs are available now. HTTP request statistics are awaiting access-log collection.** Traefik currently writes JSON access logs to `/var/log/traefik/access.log`, outside the Docker log stream collected by Alloy. Send access logs to stdout (remove `--accesslog.filepath`) and redeploy Traefik, or configure Alloy to tail that file. Request panels populate automatically once JSON access logs arrive. Empty request panels do **not** mean zero traffic. Log activity does not prove proxy health."
      }
    },
    {
      "id": 2,
      "title": "Operational error lines",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Error-severity operational lines in the selected range. Includes canceled ForwardAuth requests.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Awaiting access logs",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} !~ `\"DownstreamStatus\"\\s*:` | decolorize | line_format `{{ __line__ }}` |~ `\\bERR\\b|level=error` [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Operational warning lines",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Warning-severity operational lines in the selected range.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Awaiting access logs",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} !~ `\"DownstreamStatus\"\\s*:` | decolorize | line_format `{{ __line__ }}` |~ `\\bWRN\\b|level=warn` [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Canceled auth requests",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "ForwardAuth requests canceled before completion. Inspect timing and repetition; these alone do not prove an authentication outage.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Awaiting access logs",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "blue",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} !~ `\"DownstreamStatus\"\\s*:` | decolorize | line_format `{{ __line__ }}` |= \"ForwardAuth\" |= \"context canceled\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
