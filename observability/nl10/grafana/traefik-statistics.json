    {
      "id": 6,
      "title": "HTTP requests",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Requests completed and logged in the selected range. Requires JSON access logs.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Awaiting access logs",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Awaiting access logs",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} | json status=\"DownstreamStatus\", router=\"RouterName\", duration=\"Duration\", request_host=\"RequestHost\", method=\"RequestMethod\", path=\"RequestPath\" | __error__=\"\" | status!=\"\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "HTTP 5xx responses",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "HTTP server-error responses in the selected range. Shows zero only when access data exists.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Awaiting access logs",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Awaiting access logs",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} | json status=\"DownstreamStatus\", router=\"RouterName\", duration=\"Duration\", request_host=\"RequestHost\", method=\"RequestMethod\", path=\"RequestPath\" | __error__=\"\" | status!=\"\" | status=~\"5..\" [$__range])) or (0 * sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} | json status=\"DownstreamStatus\", router=\"RouterName\", duration=\"Duration\", request_host=\"RequestHost\", method=\"RequestMethod\", path=\"RequestPath\" | __error__=\"\" | status!=\"\" [$__range])))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "HTTP 5xx percentage",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Server-error responses divided by all logged responses over the same selected range.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Awaiting access logs",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Awaiting access logs",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} | json status=\"DownstreamStatus\", router=\"RouterName\", duration=\"Duration\", request_host=\"RequestHost\", method=\"RequestMethod\", path=\"RequestPath\" | __error__=\"\" | status!=\"\" | status=~\"5..\" [$__range])) or (0 * sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} | json status=\"DownstreamStatus\", router=\"RouterName\", duration=\"Duration\", request_host=\"RequestHost\", method=\"RequestMethod\", path=\"RequestPath\" | __error__=\"\" | status!=\"\" [$__range])))) / sum(count_over_time({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} | json status=\"DownstreamStatus\", router=\"RouterName\", duration=\"Duration\", request_host=\"RequestHost\", method=\"RequestMethod\", path=\"RequestPath\" | __error__=\"\" | status!=\"\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "title": "Request latency p95",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "95th percentile of completed request duration over the selected range, converted from nanoseconds to milliseconds. Long-lived streams can raise this value.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "Awaiting access logs",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Awaiting access logs",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} | json status=\"DownstreamStatus\", router=\"RouterName\", duration=\"Duration\", request_host=\"RequestHost\", method=\"RequestMethod\", path=\"RequestPath\" | __error__=\"\" | status!=\"\" | unwrap duration | __error__=\"\" [$__range]) by () / 1000000",
          "queryType": "instant",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "title": "Requests per minute by status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Request rate grouped by HTTP status; requires access logs.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate({source=\"docker\",container=\"traefik\",host=~\"${host:regex}\"} | json status=\"DownstreamStatus\", router=\"RouterName\", duration=\"Duration\", request_host=\"RequestHost\", method=\"RequestMethod\", path=\"RequestPath\" | __error__=\"\" | status!=\"\" [$__interval])) * 60",
          "queryType": "range",
          "instant": false,
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
