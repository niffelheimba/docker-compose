# Required by Traefik's Cloudflare DNS-01 certificate resolver.
CF_DNS_API_TOKEN=

# Optional: bind the Manager web UI to NL00's private/Tailscale IP. Omit this
# to keep it on loopback (127.0.0.1) for SSH/Tailscale port forwarding.
TMA_MANAGER_BIND_IP=100.64.0.1

# Generated by Traefik Manager after the NL00 agent is created.
TMA_NL00_API_KEY=replace-with-traefik-manager-agent-key
