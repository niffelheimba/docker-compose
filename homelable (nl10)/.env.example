# Copy to .env. Never commit .env or real secrets.
HOMELABLE_VERSION=latest
HOMELABLE_BIND_IP=0.0.0.0
HOMELABLE_PORT=3010

# Generate a random secret with at least 32 bytes (e.g. openssl rand -hex 32).
SECRET_KEY=
AUTH_MODE=oidc
CORS_ORIGINS='["https://homelable.home.northlake.dev"]'
OIDC_DISCOVERY_URL=https://idm.northlake.dev/oauth2/openid/homelable/.well-known/openid-configuration
OIDC_CLIENT_ID=homelable
# Paste the Kanidm client secret between single quotes to preserve any $ signs.
OIDC_CLIENT_SECRET=''
OIDC_REDIRECT_URI=https://homelable.home.northlake.dev/api/v1/auth/oidc/callback
OIDC_SCOPES="openid profile email"
OIDC_COOKIE_SECURE=true
OIDC_SESSION_EXPIRE_MINUTES=480

# Replace with the exact LAN CIDRs you want to scan; [] disables default targets.
SCANNER_RANGES='[]'
STATUS_CHECKER_INTERVAL=60

# Optional MCP profile: generate TWO independent random keys before enabling.
MCP_API_KEY=
MCP_SERVICE_KEY=
MCP_BIND_IP=127.0.0.1
MCP_PORT=8001
