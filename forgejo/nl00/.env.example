# Copy to .env or enter these values in Arcane's project Environment editor.
# No passwords or tokens are needed in this file.
FORGEJO_DOMAIN=git.cloud.northlake.dev
FORGEJO_ROOT_URL=https://git.cloud.northlake.dev/
FORGEJO_PROXY_NETWORK=arcane-net

# Web access is available to Traefik on the shared network at forgejo:3000.
FORGEJO_HTTP_BIND_IP=127.0.0.1
FORGEJO_HTTP_PORT=3030

# For direct Git-over-SSH access, deliberately select an appropriate host
# interface and allow this port through existing host/network controls.
FORGEJO_SSH_BIND_IP=127.0.0.1
FORGEJO_SSH_PORT=2222
