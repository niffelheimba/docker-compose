{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "docker:enableMajor"
  ],
  "timezone": "America/New_York",
  "enabledManagers": [
    "docker-compose"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "dependencyDashboardApproval": false,
  "major": {
    "dependencyDashboardApproval": true
  },
  "automerge": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "ignorePaths": [
    "archive/**",
    "fluxer.gg/**",
    "parseable/**",
    "parseable (nl00)/**"
  ],
  "packageRules": [
    {
      "description": "Local application builds are maintained with their source",
      "matchPackageNames": [
        "northlake/**"
      ],
      "enabled": false
    },
    {
      "description": "Group routine container updates by Compose file",
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest",
        "rollback",
        "bump"
      ],
      "groupName": "{{packageFile}}",
      "groupSingleUpdates": true
    },
    {
      "description": "Keep major stack upgrades separate and require dashboard approval",
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "{{packageFile}} major updates",
      "groupSingleUpdates": true,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep Kanidm replicas on the same reviewed image version",
      "matchPackageNames": [
        "kanidm/server",
        "docker.io/kanidm/server"
      ],
      "groupName": "Kanidm replicas",
      "groupSingleUpdates": true
    },
    {
      "description": "Keep Semaphore on MySQL 8.4 LTS; later series need a planned database migration",
      "matchFileNames": [
        "semaphore/nl00/compose.yaml"
      ],
      "matchPackageNames": [
        "mysql"
      ],
      "allowedVersions": "/^8\\.4\\./"
    },
    {
      "description": "Meilisearch minor and major updates require a backed-up database migration",
      "matchFileNames": [
        "karakeep/nl10/docker-compose.yaml"
      ],
      "matchPackageNames": [
        "getmeili/meilisearch"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "{{packageFile}} search database migration",
      "dependencyDashboardApproval": true
    }
  ],
  "branchConcurrentLimit": 0
}
